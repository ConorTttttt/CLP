{
  "id": "EU-CLP-PROVISION-TRANCHE-1-2026-11-12",
  "jurisdiction": "EU",
  "as_of": "2026-11-12",
  "source": {
    "eli": "https://eur-lex.europa.eu/eli/reg/2008/1272/2026-07-01",
    "source_id": "EU-CLP-02008R1272-20260701",
    "source_sha256": "602529287cbdbbb80f4bc17404fef58041ce5edf30646509b3cdb6991b7fc8a7"
  },
  "scope": "PARTIAL: only listed rules, no classification derivation, no whole-label compliance verdict",
  "effective_date_review": "REQUIRED: EU 2025/2439 modified application and transitional dates; check individual provisions in authentic OJ before compliance use",
  "rules": [
    {
      "id": "EU-17-1-A",
      "issue": "label_content",
      "legal_reference": "Article 17(1)(a)",
      "source_pdf_page": 19,
      "when": {
        "all": [
          {
            "field": "classification.is_hazardous",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.packaged",
            "op": "eq",
            "value": true
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "elements": [
          "supplier name",
          "supplier address",
          "supplier telephone number"
        ]
      },
      "reason": "Hazardous packaged products must identify supplier(s) on the label."
    },
    {
      "id": "EU-17-1-B",
      "issue": "label_content",
      "legal_reference": "Article 17(1)(b)",
      "source_pdf_page": 19,
      "when": {
        "all": [
          {
            "field": "classification.is_hazardous",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.packaged",
            "op": "eq",
            "value": true
          },
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.quantity_elsewhere_on_package",
            "op": "eq",
            "value": false
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "elements": [
          "nominal quantity on label"
        ]
      },
      "reason": "For general-public packages, nominal quantity belongs on label unless specified elsewhere on package."
    },
    {
      "id": "EU-17-1-C",
      "issue": "label_content",
      "legal_reference": "Article 17(1)(c)",
      "source_pdf_page": 19,
      "when": {
        "all": [
          {
            "field": "classification.is_hazardous",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.packaged",
            "op": "eq",
            "value": true
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "elements": [
          "product identifier per Article 18"
        ]
      },
      "reason": "Hazardous packaged products must bear a product identifier."
    },
    {
      "id": "EU-17-2",
      "issue": "label_language",
      "legal_reference": "Article 17(2)",
      "source_pdf_page": 19,
      "when": {
        "all": [
          {
            "field": "classification.is_hazardous",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.packaged",
            "op": "eq",
            "value": true
          }
        ]
      },
      "result": "REQUIRES_MEMBER_STATE_LOOKUP",
      "effect": {
        "elements": [
          "official language(s) of destination Member State unless local exception"
        ]
      },
      "reason": "Label language depends on Member State; specific language mapping is not implemented."
    },
    {
      "id": "EU-20-3",
      "issue": "signal_word_precedence",
      "legal_reference": "Article 20(3)",
      "source_pdf_page": 21,
      "when": {
        "all": [
          {
            "field": "classification.signal_word_candidates",
            "op": "contains",
            "value": "Danger"
          }
        ]
      },
      "result": "PROHIBITED",
      "effect": {
        "exclude": "Warning"
      },
      "reason": "Warning may not appear when Danger appears."
    },
    {
      "id": "EU-26-1-B",
      "issue": "pictogram_precedence",
      "legal_reference": "Article 26(1)(b)",
      "source_pdf_page": 25,
      "when": {
        "all": [
          {
            "field": "classification.pictogram_candidates",
            "op": "contains",
            "value": "GHS06"
          }
        ]
      },
      "result": "PROHIBITED",
      "effect": {
        "exclude": "GHS07"
      },
      "reason": "If GHS06 is required, GHS07 must not appear."
    },
    {
      "id": "EU-25-4",
      "issue": "misleading_label_claims",
      "legal_reference": "Article 25(4)",
      "source_pdf_page": 24,
      "when": {
        "all": [
          {
            "field": "label.claims",
            "op": "any_of",
            "value": [
              "non-toxic",
              "non-harmful",
              "non-polluting",
              "ecological"
            ]
          }
        ]
      },
      "result": "PROHIBITED",
      "effect": {
        "remove_claims": [
          "non-toxic",
          "non-harmful",
          "non-polluting",
          "ecological"
        ]
      },
      "reason": "Four expressly named prohibited claims. Broader equivalent claims require separate review."
    },
    {
      "id": "EU-35-2-DESIGN",
      "issue": "packaging_design",
      "legal_reference": "Article 35(2)",
      "source_pdf_page": 31,
      "when": {
        "all": [
          {
            "field": "classification.is_hazardous",
            "op": "eq",
            "value": true
          },
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.child_attractive_design",
            "op": "eq",
            "value": true
          }
        ]
      },
      "result": "PROHIBITED",
      "effect": {
        "action": "change child-attractive packaging"
      },
      "reason": "A general-public hazardous package may not be designed to attract children. Wider misleading-design rules are not exhaustively checked."
    },
    {
      "id": "EU-ANII-3.1.1.1",
      "issue": "child_resistant_fastening",
      "legal_reference": "Annex II, 3.1.1.1",
      "source_pdf_page": 243,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "classification.hazard_categories",
            "op": "any_of",
            "value": [
              "Acute Tox. 1",
              "Acute Tox. 2",
              "Acute Tox. 3",
              "STOT SE 1",
              "STOT RE 1",
              "Skin Corr. 1",
              "Skin Corr. 1A",
              "Skin Corr. 1B",
              "Skin Corr. 1C"
            ]
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "child-resistant fastening"
      },
      "reason": "General-public packages: listed acute toxicity/STOT/skin-corrosion categories."
    },
    {
      "id": "EU-ANII-3.1.1.2",
      "issue": "child_resistant_fastening",
      "legal_reference": "Annex II, 3.1.1.2",
      "source_pdf_page": 243,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "classification.hazard_categories",
            "op": "contains",
            "value": "Asp. Tox. 1"
          },
          {
            "field": "packaging.is_aerosol",
            "op": "eq",
            "value": false
          },
          {
            "field": "packaging.sealed_spray",
            "op": "eq",
            "value": false
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "child-resistant fastening"
      },
      "reason": "Aspiration hazard triggers CRF except aerosol/sealed spray packages, subject to detailed 3.10 provisions."
    },
    {
      "id": "EU-ANII-3.1.1.3-METHANOL",
      "issue": "child_resistant_fastening",
      "legal_reference": "Annex II, 3.1.1.3",
      "source_pdf_page": 244,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "ingredients.67-56-1",
            "op": "gte",
            "value": 3
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "child-resistant fastening"
      },
      "reason": "Methanol at least 3 percent w/w in general-public package."
    },
    {
      "id": "EU-ANII-3.1.1.3-DCM",
      "issue": "child_resistant_fastening",
      "legal_reference": "Annex II, 3.1.1.3",
      "source_pdf_page": 244,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "ingredients.75-09-2",
            "op": "gte",
            "value": 1
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "child-resistant fastening"
      },
      "reason": "Dichloromethane at least 1 percent w/w in general-public package."
    },
    {
      "id": "EU-ANII-3.2.1.1-OTHER",
      "issue": "tactile_warning",
      "legal_reference": "Annex II, 3.2.1.1-3.2.1.2",
      "source_pdf_page": 244,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.transportable_gas_receptacle",
            "op": "eq",
            "value": false
          },
          {
            "field": "classification.hazard_categories",
            "op": "any_of",
            "value": [
              "Acute Tox. 1",
              "Acute Tox. 2",
              "Acute Tox. 3",
              "Acute Tox. 4",
              "Skin Corr. 1",
              "Skin Corr. 1A",
              "Skin Corr. 1B",
              "Skin Corr. 1C",
              "Muta. 2",
              "Carc. 2",
              "Repr. 2",
              "Resp. Sens. 1",
              "Resp. Sens. 1A",
              "Resp. Sens. 1B",
              "STOT SE 1",
              "STOT SE 2",
              "STOT RE 1",
              "STOT RE 2",
              "Flam. Gas 1",
              "Flam. Gas 1A",
              "Flam. Gas 1B",
              "Flam. Gas 2",
              "Flam. Liq. 1",
              "Flam. Liq. 2",
              "Flam. Sol. 1",
              "Flam. Sol. 2"
            ]
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "tactile warning"
      },
      "reason": "Listed hazards other than aspiration in general-public packaging (transportable gas receptacle excluded)."
    },
    {
      "id": "EU-ANII-3.2.1.1-ASP",
      "issue": "tactile_warning",
      "legal_reference": "Annex II, 3.2.1.1-3.2.1.2",
      "source_pdf_page": 245,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "packaging.transportable_gas_receptacle",
            "op": "eq",
            "value": false
          },
          {
            "field": "classification.hazard_categories",
            "op": "contains",
            "value": "Asp. Tox. 1"
          },
          {
            "field": "packaging.is_aerosol",
            "op": "eq",
            "value": false
          },
          {
            "field": "packaging.sealed_spray",
            "op": "eq",
            "value": false
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "fit": "tactile warning"
      },
      "reason": "Aspiration-only hazard: aerosol and sealed-spray exceptions apply. Other classifications are evaluated separately."
    },
    {
      "id": "EU-ANII-2.1-LEAD",
      "issue": "supplemental_label",
      "legal_reference": "Annex II, 2.1",
      "source_pdf_page": 240,
      "when": {
        "all": [
          {
            "field": "product_flags.is_paint_or_varnish",
            "op": "eq",
            "value": true
          },
          {
            "field": "lead_metal_percent_w_w",
            "op": "gt",
            "value": 0.15
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "EUH": "EUH201",
        "text": "Contains lead. Should not be used on surfaces liable to be chewed or sucked by children",
        "note": "EUH201A alternative may apply to packages under 125 ml"
      },
      "reason": "Paints/varnishes with lead above 0.15% w/w of mixture."
    },
    {
      "id": "EU-ANII-2.2-CYANO",
      "issue": "supplemental_label",
      "legal_reference": "Annex II, 2.2",
      "source_pdf_page": 241,
      "when": {
        "all": [
          {
            "field": "product_flags.cyanoacrylate_adhesive",
            "op": "eq",
            "value": true
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "EUH": "EUH202"
      },
      "reason": "Immediate packaging of cyanoacrylate adhesives requires EUH202 and safety advice."
    },
    {
      "id": "EU-ANII-2.4-ISOCYANATES",
      "issue": "supplemental_label",
      "legal_reference": "Annex II, 2.4",
      "source_pdf_page": 241,
      "when": {
        "all": [
          {
            "field": "product_flags.contains_isocyanates",
            "op": "eq",
            "value": true
          },
          {
            "field": "product_flags.isocyanates_already_identified_on_label",
            "op": "eq",
            "value": false
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "EUH": "EUH204"
      },
      "reason": "Mixtures containing isocyanates unless already identified on label."
    },
    {
      "id": "EU-ANII-2.5-EPOXY",
      "issue": "supplemental_label",
      "legal_reference": "Annex II, 2.5",
      "source_pdf_page": 241,
      "when": {
        "all": [
          {
            "field": "product_flags.contains_epoxy_mw_lte_700",
            "op": "eq",
            "value": true
          },
          {
            "field": "product_flags.epoxy_already_identified_on_label",
            "op": "eq",
            "value": false
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "EUH": "EUH205"
      },
      "reason": "Mixtures with epoxy constituents average MW <=700 unless already identified on label."
    },
    {
      "id": "EU-ANII-2.6-CHLORINE",
      "issue": "supplemental_label",
      "legal_reference": "Annex II, 2.6",
      "source_pdf_page": 241,
      "when": {
        "all": [
          {
            "field": "general_public",
            "op": "eq",
            "value": true
          },
          {
            "field": "active_chlorine_percent",
            "op": "gt",
            "value": 1
          }
        ]
      },
      "result": "REQUIRED",
      "effect": {
        "EUH": "EUH206"
      },
      "reason": "General-public mixtures with more than 1% active chlorine."
    }
  ]
}
