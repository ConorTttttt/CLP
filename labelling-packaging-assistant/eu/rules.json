{
  "ruleset_id": "EU-DEMONSTRATION-2026-11-12",
  "jurisdiction": "EU",
  "effective_snapshot": "2026-11-12",
  "legal_source_url": "https://eur-lex.europa.eu/eli/reg/2008/1272/2026-07-01",
  "source_status": "Demonstration: each rule and the entire law-state require legal validation before deployment",
  "rules": [
    {
      "id": "EU-CRF-METHANOL-3",
      "issue": "child_resistant_fastening",
      "conditions": {"all": [
        {"field": "general_public", "op": "eq", "value": true},
        {"field": "ingredients_w_w_percent.67-56-1", "op": "gte", "value": 3}
      ]},
      "status_if_matched": "REQUIRED",
      "rationale": "Consumer product contains methanol at or above 3% by weight.",
      "legal_basis": "EU CLP: Annex II, Part 3, section 3.1.1.3"
    },
    {
      "id": "EU-CRF-DCM-1",
      "issue": "child_resistant_fastening",
      "conditions": {"all": [
        {"field": "general_public", "op": "eq", "value": true},
        {"field": "ingredients_w_w_percent.75-09-2", "op": "gte", "value": 1}
      ]},
      "status_if_matched": "REQUIRED",
      "rationale": "Consumer product contains dichloromethane at or above 1% by weight.",
      "legal_basis": "EU CLP: Annex II, Part 3, section 3.1.1.3"
    },
    {
      "id": "EU-CRF-H314",
      "issue": "child_resistant_fastening",
      "conditions": {"all": [
        {"field": "general_public", "op": "eq", "value": true},
        {"field": "classification.hazard_statements", "op": "contains", "value": "H314"}
      ]},
      "status_if_matched": "REQUIRED",
      "rationale": "Consumer product has a manually approved skin corrosion classification represented by H314.",
      "legal_basis": "EU CLP: Annex II, Part 3, section 3.1.1.1"
    },
    {
      "id": "EU-SIGNAL-DANGER",
      "issue": "signal_word_precedence",
      "conditions": {"all": [
        {"field": "classification.signal_words_from_classification", "op": "contains", "value": "Danger"}
      ]},
      "status_if_matched": "APPLY_PRECEDENCE",
      "output": {"signal_word": "Danger", "exclude_signal_word": "Warning"},
      "rationale": "Danger takes precedence over Warning.",
      "legal_basis": "EU CLP: Article 20(3)"
    },
    {
      "id": "EU-GHS06-GHS07",
      "issue": "pictogram_precedence",
      "conditions": {"all": [
        {"field": "classification.pictograms_from_classification", "op": "contains", "value": "GHS06"}
      ]},
      "status_if_matched": "APPLY_PRECEDENCE",
      "output": {"exclude_pictogram": "GHS07"},
      "rationale": "A GHS06 pictogram prevents use of GHS07.",
      "legal_basis": "EU CLP: Article 26(1)(b)"
    }
  ]
}
